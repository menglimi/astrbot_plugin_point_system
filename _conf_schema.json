{
  "points_name": {
    "description": "积分自定义名称",
    "type": "string",
    "hint": "你可以将“积分”改为“金币”、“贡献度”或“欧气值”等。",
    "default": "积分"
  },
  "sign_in_trigger": {
    "description": "无前缀签到完整触发词（兼容旧配置）",
    "type": "string",
    "hint": "旧版兼容项。若已配置签到触发关键词，则会同时支持“关键词+签到”和“签到+关键词”。",
    "default": "星缘签到"
  },
  "sign_in_trigger_keyword": {
    "description": "无前缀签到触发关键词",
    "type": "string",
    "hint": "例如填“群名简称”后，用户可直接发送“关键词+签到”或“签到+关键词”进行签到。",
    "default": "星缘"
  },
  "lottery_trigger_keyword": {
    "description": "无前缀抽奖触发关键词",
    "type": "string",
    "hint": "例如填“群名简称”后，用户可直接发送“关键词+抽奖”或“抽奖+关键词”参与默认模式抽奖。",
    "default": "星缘"
  },
  "lottery_trigger": {
    "description": "无前缀抽奖完整触发词（兼容旧配置）",
    "type": "string",
    "hint": "兼容完整口令。若已配置抽奖触发关键词，则会同时支持“关键词+抽奖”和“抽奖+关键词”；这里填写完整词时也会直接匹配该短语。",
    "default": "星缘抽奖"
  },
  "sign_in_settings": {
    "description": "签到功能设置",
    "type": "object",
    "items": {
      "sign_in_mode": {
        "description": "签到积分模式",
        "type": "string",
        "hint": "random 为随机积分，fixed 为固定积分。",
        "default": "random"
      },
      "fixed_sign_in_points": {
        "description": "固定签到积分",
        "type": "int",
        "hint": "当签到积分模式为 fixed 时，每日签到固定获得多少积分。",
        "default": 20
      },
      "min_sign_in_points": {
        "description": "签到获得积分下限",
        "type": "int",
        "hint": "每日签到随机获得的最小积分数额。",
        "default": 10
      },
      "max_sign_in_points": {
        "description": "签到获得积分上限",
        "type": "int",
        "hint": "每日签到随机获得的最大积分数额。",
        "default": 30
      },
      "first_sign_in_bonus": {
        "description": "首次签到奖励",
        "type": "int",
        "hint": "用户第一次签到时额外获得的积分。",
        "default": 20
      },
      "daily_first_sign_in_bonus": {
        "description": "每日首签奖励",
        "type": "int",
        "hint": "每天第一个完成签到的用户可额外获得的积分，签到日于每日 04:00 刷新。",
        "default": 0
      },
      "fortune_event_enabled": {
        "description": "是否开启签到稀有彩蛋",
        "type": "bool",
        "hint": "开启后，签到时会有极低概率触发欧皇或非酋事件。",
        "default": true
      },
      "fortune_event_chance": {
        "description": "签到稀有彩蛋概率",
        "type": "float",
        "hint": "默认 0.002，表示 0.2% 概率触发欧皇/非酋事件。",
        "default": 0.002
      },
      "fortune_event_points": {
        "description": "签到稀有彩蛋积分变化",
        "type": "int",
        "hint": "触发欧皇时加分，触发非酋时扣分，默认 300。",
        "default": 300
      },
      "fortune_pity_enabled": {
        "description": "是否开启签到彩蛋保底",
        "type": "bool",
        "hint": "开启后，欧皇和非酋会分别按独立计数触发保底。",
        "default": true
      },
      "fortune_lucky_pity_threshold": {
        "description": "欧皇保底次数",
        "type": "int",
        "hint": "连续多少次签到未触发欧皇后保底触发一次，默认 100；填 0 表示关闭欧皇保底。",
        "default": 100
      },
      "fortune_unlucky_pity_threshold": {
        "description": "非酋保底次数",
        "type": "int",
        "hint": "连续多少次签到未触发非酋后保底触发一次，默认 100；填 0 表示关闭非酋保底。",
        "default": 100
      },
      "streak_bonus_enabled": {
        "description": "是否开启连续签到奖励",
        "type": "bool",
        "hint": "开启后，连续签到会按天数获得额外加成。",
        "default": true
      },
      "streak_step_bonus": {
        "description": "连续签到每日加成",
        "type": "int",
        "hint": "从连续签到第 2 天开始，每多一天增加多少积分。",
        "default": 2
      },
      "streak_bonus_cap": {
        "description": "连续签到加成上限",
        "type": "int",
        "hint": "连续签到额外加成的最大值，避免数值膨胀。",
        "default": 20
      },
      "weekly_streak_bonus": {
        "description": "连续 7 天奖励",
        "type": "int",
        "hint": "每逢连续签到第 7、14、21... 天时额外获得的奖励。",
        "default": 15
      },
      "make_up_cost": {
        "description": "补签消耗",
        "type": "int",
        "hint": "发送 /补签 时消耗的积分；填 0 表示免费补签。",
        "default": 100
      },
      "make_up_monthly_limit": {
        "description": "每月补签上限",
        "type": "int",
        "hint": "每个用户每月最多补签次数；填 0 表示不限次数。",
        "default": 1
      }
    }
  },
  "activity_settings": {
    "description": "群聊活跃奖励设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否开启活跃奖励",
        "type": "bool",
        "hint": "开启后，用户发送合规群消息时可静默获得积分。",
        "default": true
      },
      "points_per_message": {
        "description": "每次活跃奖励积分",
        "type": "int",
        "hint": "每次满足条件的群消息可获得多少积分。",
        "default": 1
      },
      "cooldown_seconds": {
        "description": "活跃奖励冷却时间",
        "type": "int",
        "hint": "同一用户两次活跃奖励之间至少间隔多少秒。",
        "default": 300
      },
      "daily_limit": {
        "description": "每日活跃奖励上限次数",
        "type": "int",
        "hint": "单个用户每天最多通过活跃消息获取多少次积分。",
        "default": 6
      },
      "min_text_length": {
        "description": "活跃消息最短长度",
        "type": "int",
        "hint": "消息纯文本少于该长度时，不计入活跃奖励。",
        "default": 4
      }
    }
  },
  "steal_settings": {
    "description": "偷积分设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否开启偷积分",
        "type": "bool",
        "hint": "开启后，用户可在群聊中使用 /偷积分 @用户 尝试偷取积分。",
        "default": false
      },
      "daily_steal_limit": {
        "description": "每人每日可偷次数",
        "type": "int",
        "hint": "单个用户每天最多发起多少次偷积分；填 0 表示不限次数。",
        "default": 3
      },
      "daily_be_stolen_limit": {
        "description": "每人每日可被偷次数",
        "type": "int",
        "hint": "单个用户每天最多被成功偷取多少次；填 0 表示不限次数。",
        "default": 3
      },
      "min_points": {
        "description": "偷取积分下限",
        "type": "int",
        "hint": "偷取成功时随机获得的最少积分。",
        "default": 1
      },
      "max_points": {
        "description": "偷取积分上限",
        "type": "int",
        "hint": "偷取成功时随机获得的最多积分，实际不会超过被偷者余额。",
        "default": 20
      },
      "success_probability": {
        "description": "偷取成功概率",
        "type": "float",
        "hint": "填写 0 到 1 之间的小数，例如 0.5 表示 50% 成功率。",
        "default": 0.5
      },
      "failure_cost": {
        "description": "偷取失败扣除积分",
        "type": "int",
        "hint": "偷取失败时从发起者扣除的积分，填 0 表示失败不扣分。",
        "default": 0
      },
      "failure_cost_to_victim": {
        "description": "失败扣除是否转给被偷者",
        "type": "bool",
        "hint": "开启后，失败扣除的积分会转给被偷者；关闭则积分直接从系统中扣除。",
        "default": true
      }
    }
  },
  "birthday_settings": {
    "description": "生日功能设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否开启生日功能",
        "type": "bool",
        "hint": "关闭后将停用生日签到、生日奖励和定时寿星播报。",
        "default": true
      },
      "sign_in_trigger": {
        "description": "生日签到触发词",
        "type": "string",
        "hint": "用户发送该文本时触发生日签到，例如“生日签到”。",
        "default": "生日签到"
      },
      "reward_points": {
        "description": "生日签到奖励积分",
        "type": "int",
        "hint": "生日签到成功时奖励多少积分。",
        "default": 50
      },
      "auto_record_when_unset": {
        "description": "未记录生日时自动记录今天",
        "type": "bool",
        "hint": "开启后，用户首次使用生日签到时，会自动把当天记为生日。",
        "default": true
      },
      "auto_broadcast_enabled": {
        "description": "是否开启生日名单播报",
        "type": "bool",
        "hint": "开启后，插件会在设定时间自动检查并播报当日寿星名单。",
        "default": true
      },
      "auto_broadcast_time": {
        "description": "生日名单播报时间",
        "type": "string",
        "hint": "按 24 小时制填写，例如 08:00 或 20:30。",
        "default": "08:00"
      }
    }
  },
  "lottery_settings": {
    "description": "积分抽奖设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否开启积分抽奖",
        "type": "bool",
        "hint": "开启后，用户可通过 /抽奖 消耗积分参与抽奖。",
        "default": true
      },
      "default_mode": {
        "description": "默认抽奖模式",
        "type": "string",
        "hint": "支持 personal 或 group；用户直接发送 /抽奖 时会使用这里的模式。",
        "default": "personal"
      },
      "personal_enabled": {
        "description": "是否开启个人抽奖",
        "type": "bool",
        "hint": "相当于个人抽奖功能开关。",
        "default": true
      },
      "group_enabled": {
        "description": "是否开启群体抽奖",
        "type": "bool",
        "hint": "相当于群体抽奖功能开关。",
        "default": true
      },
      "personal_cost": {
        "description": "个人抽奖消耗积分",
        "type": "int",
        "hint": "每次个人抽奖消耗多少积分。",
        "default": 20
      },
      "personal_daily_limit": {
        "description": "个人抽奖每日次数",
        "type": "int",
        "hint": "每个用户每天最多可进行多少次个人抽奖。",
        "default": 1
      },
      "personal_prizes": {
        "description": "个人抽奖奖项设置",
