      "group_cost": {
        "description": "群体抽奖报名消耗积分",
        "type": "int",
        "hint": "每位用户参加一次群体抽奖需要消耗的积分。",
        "default": 20
      },
      "group_daily_limit_per_user": {
        "description": "群体抽奖每人每日次数",
        "type": "int",
        "hint": "每个用户每天最多可参加几次群体抽奖。",
        "default": 1
      },
      "group_required_participants": {
        "description": "群体抽奖开奖人数",
        "type": "int",
        "hint": "群体抽奖达到该人数后立即开奖。",
        "default": 5
      },
      "group_distribution_ratios": {
        "description": "群体抽奖分配比例",
        "type": "list",
        "hint": "按参与人数顺序对应的分配比例，例如 1,9,20,25,35。比例会自动归一化后分配奖池。",
        "default": [1, 9, 20, 25, 35]
      }
    }
  },
  "special_date_reward_entries": {
    "description": "日期口令奖励词条",
    "type": "template_list",
    "hint": "参考世界书词条形式配置。满足日期和关键词后，用户发送消息即可获得指定积分。",
    "templates": {
      "default": {
        "name": "活动奖励词条",
        "items": {
          "name": {
            "description": "词条名称",
            "type": "string",
            "hint": "用于区分不同的活动奖励。",
            "default": "节日奖励"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "priority": {
            "description": "优先级",
            "type": "int",
            "hint": "同一条消息命中多条词条时，优先级越小越先判定。",
            "default": 50
          },
          "scope": {
            "description": "生效范围",
            "type": "list",
            "hint": "可填写群号、QQ号，或使用 group:群号 / user:QQ号；留空表示不限制。",
            "default": []
          },
          "dates": {
            "description": "生效日期",
            "type": "list",
            "hint": "支持 YYYY-MM-DD、MM-DD 或 M-D，例如 2026-04-04 或 04-04。",
            "default": ["04-04"]
          },
          "keywords": {
            "description": "触发词",
            "type": "list",
            "hint": "支持正则表达式；开启精确匹配后则按完整文本匹配。",
            "default": ["清明安康"]
          },
          "exact_match": {
            "description": "是否精确匹配",
            "type": "bool",
            "hint": "开启后，消息内容必须与触发词完全一致。",
            "default": true
          },
          "reward_points": {
            "description": "奖励积分",
            "type": "int",
            "default": 20
          },
          "daily_limit_per_user": {
            "description": "每人每日触发次数",
            "type": "int",
            "hint": "通常保持 1 即可，避免重复刷取。",
            "default": 1
          },
          "probability": {
            "description": "触发概率",
            "type": "float",
            "hint": "1 表示必定触发，小于 1 表示按概率触发。",
            "default": 1.0
          },
          "announce": {
            "description": "是否发送提示消息",
            "type": "bool",
            "hint": "关闭后只发放积分，不额外回复。",
            "default": true
          },
          "reply_template": {
            "description": "提示模板",
            "type": "string",
            "hint": "支持 {user}、{entry}、{points}、{name}、{total}、{date}。",
            "default": "{user}触发活动词条【{entry}】，获得 {points} {name}。\n当前共有 {total} {name}。"
          }
        }
      }
    }
  },
  "backup_settings": {
    "description": "自动备份设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否开启自动备份",
        "type": "bool",
        "hint": "开启后，插件会在设定时间自动备份积分数据文件。",
        "default": false
      },
      "backup_paths": {
        "description": "备份地址列表",
        "type": "list",
        "hint": "可填写目录或文件路径。填写目录时会自动生成带时间戳的备份文件；可同时配置多个地址。",
        "default": []
      },
      "auto_backup_time": {
        "description": "自动备份时间",
        "type": "string",
        "hint": "按 24 小时制填写，例如 03:00 或 23:30。",
        "default": "03:00"
      }
    }
  },
  "negative_settings": {
    "description": "负分提示设置",
    "type": "object",
    "items": {
      "debt_message": {
        "description": "负分状态提示文案",
        "type": "string",
        "hint": "用户在负分状态下尝试抽奖时显示的提示文案。",
        "default": "你已背负债务，请穿上女仆装打工。"
      }
    }
  },
  "leaderboard_settings": {
    "description": "排行榜设置",
    "type": "object",
    "items": {
      "display_limit": {
        "description": "排行榜显示人数",
        "type": "int",
        "hint": "执行 /积分榜 时展示的用户数量。",
        "default": 10
      },
      "show_self_rank": {
        "description": "是否在榜单下方显示自己的排名",
        "type": "bool",
        "hint": "如果开启，用户在查看排行榜时能看到自己当前的位次。",
        "default": true
      }
    }
  },
  "message_templates": {
    "description": "自定义回复消息模板",
    "type": "object",
    "hint": "可使用 {user}、{points}、{name}、{total}、{streak}、{total_sign_in_days}、{sign_in_status}、{bonus_detail} 等变量。",
    "items": {
      "sign_in_success": {
        "description": "签到成功提示",
        "type": "string",
        "default": "{user}来签到了，拿到 {points} {name}{bonus_detail}。\n现在攒到 {total} {name} 了，已连签 {streak} 天，累计签到 {total_sign_in_days} 天。",
        "hint": "支持变量：{user}, {points}, {name}, {total}, {streak}, {total_sign_in_days}, {bonus_detail}"
      },
      "already_signed_in": {
        "description": "重复签到提示",
        "type": "string",
        "default": "{user}今天已经签过到啦。\n现在有 {total} {name}，已连签 {streak} 天，累计签到 {total_sign_in_days} 天。",
        "hint": "支持变量：{user}, {total}, {name}, {streak}, {total_sign_in_days}"
      },
      "query_points": {
        "description": "积分查询提示",
        "type": "string",
        "default": "{user}这边查到你现在有 {total} {name}。\n已连签 {streak} 天，累计签到 {total_sign_in_days} 天，今日状态是 {sign_in_status}。",
        "hint": "支持变量：{user}, {total}, {name}, {streak}, {total_sign_in_days}, {sign_in_status}"
      }
    }
  },
  "admin_settings": {
    "description": "管理相关设置",
    "type": "object",
    "items": {
      "log_operations": {
        "description": "记录管理员操作日志",
        "type": "bool",
        "hint": "是否在后台日志中记录管理员加减积分的行为。",
        "default": true
      },
      "max_admin_give": {
        "description": "单次手动增减积分上限",
        "type": "int",
        "hint": "限制管理员单次使用指令赠送或扣除的最大分值，防止误操作。",
        "default": 1000
      },
      "points_admin_ids": {
        "description": "积分管理员 QQ 列表",
        "type": "list",
        "hint": "只有这里配置的 QQ 号可以使用 /给积分 和 /扣积分，例如填写 123456789。",
        "default": []
      }
    }
  },
  "red_packet_settings": {
    "description": "积分红包设置",
    "type": "object",
    "hint": "管理员可在群里创建固定、拼手气或口令红包；红包由系统发放，不扣管理员个人积分。",
    "items": {
      "enabled": {
        "description": "是否开启积分红包",
        "type": "bool",
        "hint": "关闭后管理员不能创建新红包，已经发出的红包仍可按原规则领取。",
        "default": true
      },
      "max_total_points": {
        "description": "单个红包积分上限",
        "type": "int",
        "hint": "用于减少误操作；需要更大额度时可按实际活动规模调整。",
        "default": 100000
      },
      "max_count": {
        "description": "单个红包最多份数",
        "type": "int",
        "hint": "固定、拼手气和口令红包都受此上限保护。",
        "default": 100
      },
      "expire_minutes": {
        "description": "红包有效时长（分钟）",
        "type": "int",
        "hint": "默认 1440 分钟（24 小时）；填 0 表示不过期。过期红包不会再发放剩余积分。",
        "default": 1440
      }
    }
  },
  "exchange_items": {
    "description": "自定义兑换物（首次使用先配置这里）",
    "type": "template_list",
    "hint": "首次使用：新增一项，填写名称、所需积分和至少一份发放内容后保存。用户先发送 /兑换列表，再在群里发送 /兑换 名称；需要保密时，Bot 会把结果私聊给用户。名称、内容类型和发放渠道都可以按需设置。",
    "templates": {
      "default": {
        "name": "通用兑换物",
        "items": {
          "name": {
            "description": "兑换物名称",
            "type": "string",
            "hint": "用户会在 /兑换列表 中看到该名称，并用 /兑换 名称 领取。建议使用简短、容易区分的名称，例如“群福利”“资料包”或“周边领取券”。",
            "default": "群福利"
          },
          "enabled": {
            "description": "启用该兑换物",
            "type": "bool",
            "hint": "开启后会显示在 /兑换列表 中；还在准备名称或库存时可以先关闭，配置不会丢失。",
            "default": true
          },
          "cost": {
            "description": "所需积分",
            "type": "int",
            "hint": "每成功兑换一次扣除的积分。首次测试时可设置为测试用户容易获得的数值，确认流程后再调整。",
            "default": 100
          },
          "content_type": {
            "description": "奖励类型",
            "type": "string",
            "hint": "text 文本、image 图片、video 视频；管理页会按类型显示对应编辑区。",
            "default": "text"
          },
          "contents": {
            "description": "发放内容（每项是一份库存）",
            "type": "list",
            "hint": "每行一份内容，默认按文本发送；也可填写 image:https://图片地址 或 video:https://视频地址 发送媒体。默认每行只发放一次；留空可保存，但没有内容时用户无法兑换。",
            "default": []
          },
          "repeatable": {
            "description": "允许重复兑换",
            "type": "bool",
            "hint": "开启后不消耗库存，用户每次兑换都会再次获得同一份内容；适合永久链接、电子资料或权益类兑换物。",
            "default": false
          },
          "selection_mode": {
            "description": "内容发放顺序",
            "type": "string",
            "hint": "sequential 按内容列表顺序发放；random 每次从可用内容中随机抽取。随机模式关闭允许重复兑换时，抽到的内容发放后会从库存中移除。",
            "default": "sequential"
          },
          "private_only": {
            "description": "通过私聊发放结果",
            "type": "bool",
            "hint": "开启后，用户仍在群聊发送 /兑换 名称，Bot 会把兑换内容主动私聊给用户，群里只显示成功提示；内容可以公开时可关闭。",
            "default": true
          },
          "success_template": {
            "description": "兑换成功提示",
            "type": "string",
            "hint": "可直接保留默认值。支持 {item}（名称）、{content}（本次内容）、{cost}（消耗）、{points_name}（积分名）、{remaining}（余额）；未写 {content} 时插件会自动追加，未识别的占位符会原样显示。",
            "default": "兑换成功！\n兑换物：{item}\n兑换内容：{content}\n消耗 {cost} {points_name}，剩余 {remaining} {points_name}。"
          }
        }
      }
    }
  },
  "exchange_scope": {
    "description": "自定义兑换物适用范围",
    "type": "object",
    "hint": "默认黑名单模式且范围留空，所有群和账号都可使用。可填写群号、QQ号，或使用 group:群号 / user:QQ号；切换为白名单后，只允许命中的群或账号兑换。",
    "items": {
      "mode": {
        "description": "范围模式",
        "type": "string",
        "hint": "blacklist 表示排除列表中的群或账号，whitelist 表示只允许列表中的群或账号；未填写或填写其他值时按 blacklist 处理。",
        "default": "blacklist"
      },
      "scope": {
        "description": "群号或账号列表",
        "type": "list",
        "hint": "每行填写一个群号或 QQ 号，也可以加 group: / user: 前缀。黑名单留空表示不限制；白名单留空时不会向任何群开放，先添加范围再切换模式更稳妥。",
        "default": []
      }
    }
  },
  "exchange_settings": {
    "description": "群功能兑换设置（可选）",
    "type": "object",
    "hint": "这里控制群头衔、设精和禁言等平台功能，不影响上方的自定义兑换物。只使用自定义礼品兑换时，可按需关闭不使用的项目。",
    "items": {
      "title_enabled": {
        "description": "是否开启兑换头衔",
        "type": "bool",
        "hint": "开启后，用户可通过 /兑换头衔 消耗积分为自己设置群头衔。",
        "default": true
      },
      "title_cost": {
        "description": "兑换头衔消耗积分",
        "type": "int",
        "hint": "每次兑换群头衔需要消耗的积分数量。",
        "default": 200
      },
      "title_max_length": {
        "description": "头衔最大长度",
        "type": "int",
        "hint": "限制 /兑换头衔 的可输入长度，避免平台接口拒绝。",
        "default": 6
      },
      "essence_enabled": {
        "description": "是否开启兑换设精",
        "type": "bool",
        "hint": "开启后，用户回复消息并发送 /兑换设精 可将该消息设为精华。",
        "default": true
      },
      "essence_cost": {
        "description": "兑换设精消耗积分",
        "type": "int",
        "hint": "每次将消息设为精华需要消耗的积分数量。",
        "default": 300
      },
      "mute_enabled": {
        "description": "是否开启兑换禁言",
        "type": "bool",
        "hint": "开启后，用户可通过 /兑换禁言 消耗积分兑换禁言效果。",
        "default": true
      },
      "mute_cost": {
        "description": "兑换禁言消耗积分",
        "type": "int",
        "hint": "每次兑换禁言需要消耗的积分数量。",
        "default": 500
      },
      "mute_duration_seconds": {
        "description": "兑换禁言时长（秒）",
        "type": "int",
        "hint": "成功兑换后执行的禁言时长。",
        "default": 60
      },
      "allow_mute_others": {
        "description": "是否允许禁言他人",
        "type": "bool",
        "hint": "关闭时，/兑换禁言 只会禁言自己；开启后可通过 @用户 禁言别人。",
        "default": false
      }
    }
  }
}
